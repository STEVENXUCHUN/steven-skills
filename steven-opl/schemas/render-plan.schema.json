{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render-plan.schema.json",
  "title": "Steven OPL render plan",
  "type": "object",
  "required": ["schema_version", "task_id", "plan_id", "approved_sha256", "template_selection", "rows"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "approved_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "template_selection": {
      "type": "object",
      "required": ["template_id", "template_version"],
      "properties": {
        "template_id": {"const": "steven-opl-standard"},
        "template_version": {"const": "1.1.0"}
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["row_id", "title", "text", "image_ids", "content_refs"],
        "properties": {
          "row_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "image_ids": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
          "content_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "image_side": {"enum": ["left", "right", "full_width"]}
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "required": ["approved", "approved_at", "approved_by", "source_ref", "plan_sha256"],
      "properties": {
        "approved": {"const": true},
        "approved_at": {"type": "string"},
        "approved_by": {"const": "user"},
        "source_ref": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
